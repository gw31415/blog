{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "browser": { "binding": "BROWSER" },
  "observability": {
    "enabled": true,
  },
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "blog-images" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-posts",
      "database_id": "74e71308-26ca-42d5-b319-6100b7823b4f",
      "migrations_dir": "migrations",
    },
  ],
}
