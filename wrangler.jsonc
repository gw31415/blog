{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "amas.dev", "custom_domain": true }],
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  // Cloudflare Access: Blog Editor (amas.dev/auth/login).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://gw31415.cloudflareaccess.com",
    "ACCESS_AUD": "982d5073afdd4f4ba9be453e7917dabdb1499f5e6102184fa400af1c445c743c",
  },
  "browser": { "binding": "BROWSER" },
  "observability": {
    "enabled": true,
  },
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "blog-images", "remote": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-posts",
      "database_id": "74e71308-26ca-42d5-b319-6100b7823b4f",
      "migrations_dir": "migrations",
      "remote": true,
    },
  ],
}
