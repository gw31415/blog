{
  "name": "my-qwik-empty-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vp build",
    "build.server": "qwik check-client src dist && vp build -c adapters/cloudflare-workers/vite.config.ts",
    "build.types": "wrangler types && tsc --incremental --noEmit",
    "check": "vp check",
    "check.fmt": "vp fmt --check",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "vp dev -c adapters/cloudflare-workers/vite.config.ts --mode ssr",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "preview": "pnpm run build && wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@qstyle/qwik": "^0.2.0",
    "@qstyle/vite": "^0.2.0",
    "@qwik.dev/core": "2.0.0-beta.43",
    "@qwik.dev/router": "2.0.0-beta.43",
    "@types/node": "26.4.1",
    "eslint-plugin-qwik": "2.0.0-beta.43",
    "typescript": "^7.0.2",
    "vite-plus": "^0.3.0",
    "wrangler": "^4.128.0"
  },
  "engines": {
    "node": "^26"
  },
  "packageManager": "pnpm@12.2.1"
}
