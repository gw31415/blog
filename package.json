{
  "name": "my-qwik-empty-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vp build",
    "build.server": "qwik check-client src dist && vp build -c adapters/cloudflare-workers/vite.config.ts",
    "build.types": "wrangler types && tsc --incremental --noEmit",
    "check": "vp check",
    "check:editor-chunk": "node scripts/check-editor-chunk.mjs",
    "check.fmt": "vp fmt --check",
    "db:migrate:local": "wrangler d1 migrations apply blog-posts --local",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "vp dev -c adapters/cloudflare-workers/vite.config.ts --mode ssr --host 0.0.0.0",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "preview": "pnpm run build && wrangler dev",
    "test": "vp test run"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/static-renderer": "3.31.3",
    "lowlight": "3.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@playwright/test": "^1.63.0",
    "@qstyle/qwik": "^0.2.0",
    "@qstyle/vite": "^0.2.0",
    "@qwik.dev/core": "2.0.0-beta.43",
    "@qwik.dev/router": "2.0.0-beta.43",
    "@types/node": "26.4.1",
    "@unocss/reset": "^66.10.5",
    "eslint-plugin-qwik": "2.0.0-beta.43",
    "highlight.js": "^11.12.0",
    "mathjax-full": "^3.2.2",
    "typescript": "^7.0.2",
    "vite-plus": "^0.3.0",
    "wrangler": "^4.128.0"
  },
  "engines": {
    "node": "^26"
  },
  "packageManager": "pnpm@12.2.1"
}
