{
  "name": "amas-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "icons:generate": "node scripts/generate-site-icons.mjs",
    "build": "qwik build",
    "build.client": "vp build",
    "build.server": "qwik check-client src dist && vp build -c adapters/cloudflare-workers/vite.config.ts",
    "build.types": "wrangler types && tsc --incremental --noEmit",
    "check": "vp check",
    "check:editor-chunk": "node scripts/check-editor-chunk.mjs",
    "check.fmt": "vp fmt --check",
    "db:migrate:local": "wrangler d1 migrations apply blog-posts --local",
    "deploy": "pnpm run build && pnpm run deploy:built",
    "dev": "vp dev -c adapters/cloudflare-workers/vite.config.ts --mode ssr --host 0.0.0.0",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "preview": "pnpm run build && wrangler dev",
    "test": "vp test run",
    "db:seed:local": "node scripts/seed-document.mjs && wrangler d1 execute blog-posts --local --file scripts/seed-document.sql",
    "db:reset:local": "node scripts/reset-local-db.mjs --discard-test-data",
    "db:migrate:remote": "wrangler d1 migrations apply blog-posts --remote",
    "deploy:built": "pnpm run db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/static-renderer": "3.31.3",
    "entities": "^8.1.0",
    "gifuct-js": "^2.1.2",
    "jose": "^6.2.12",
    "lowlight": "3.3.0",
    "marked": "18.0.14",
    "mermaid": "12.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.1",
    "@playwright/test": "^1.63.0",
    "@qstyle/qwik": "^0.2.0",
    "@qstyle/vite": "^0.2.0",
    "@qwik.dev/core": "2.0.0-beta.45",
    "@qwik.dev/router": "2.0.0-beta.45",
    "@types/node": "26.6.2",
    "@unocss/reset": "^66.10.5",
    "eslint-plugin-qwik": "2.0.0-beta.45",
    "highlight.js": "^11.12.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0-rc.0",
    "wrangler": "^4.140.0"
  },
  "engines": {
    "node": "^26"
  },
  "packageManager": "pnpm@12.6.0"
}
