{
  "name": "amas-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "icons:generate": "node scripts/generate-site-icons.mjs",
    "build": "qwik build",
    "build.client": "vp build",
    "build.server": "qwik check-client src dist && vp build -c adapters/cloudflare-workers/vite.config.ts && node scripts/finalize-worker.mjs && vp build -c adapters/cloudflare-workers/bundle.config.ts",
    "build.types": "cf workers types && tsc --incremental --noEmit",
    "check": "vp check",
    "check:editor-chunk": "node scripts/check-editor-chunk.mjs",
    "check.fmt": "vp fmt --check",
    "db:migrate:local": "cf d1 migrations apply 74e71308-26ca-42d5-b319-6100b7823b4f --local --persist-to \"${BLOG_LOCAL_STATE:-.cache/webmcp-test}\"",
    "deploy": "pnpm run build && pnpm run deploy:built",
    "dev": "vp dev -c adapters/cloudflare-workers/vite.config.ts --mode ssr --host 0.0.0.0",
    "fmt": "vp fmt",
    "lint": "vp lint --max-warnings=0",
    "preview": "pnpm run build && pnpm run preview:built",
    "test": "vp test run",
    "db:seed:local": "tsx scripts/seed-document.mjs && cf d1 raw 74e71308-26ca-42d5-b319-6100b7823b4f --local --persist-to \"${BLOG_LOCAL_STATE:-.cache/webmcp-test}\" --sql @scripts/seed-document.sql",
    "db:reset:local": "node scripts/reset-local-db.mjs --discard-test-data",
    "db:migrate:remote": "cf d1 migrations apply 74e71308-26ca-42d5-b319-6100b7823b4f --dir migrations",
    "deploy:built": "pnpm run db:migrate:remote && cf deploy --prebuilt",
    "media:migrate": "tsx scripts/migrate-media.ts",
    "media:audit": "tsx scripts/migrate-media.ts --audit",
    "preview:built": "vp preview -c adapters/cloudflare-workers/bundle.config.ts"
  },
  "dependencies": {
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/static-renderer": "3.31.3",
    "@xmldom/xmldom": "^0.9.12",
    "entities": "^8.1.0",
    "gifuct-js": "^2.1.2",
    "jose": "^6.2.12",
    "lowlight": "3.3.0",
    "marked": "18.0.14",
    "mermaid": "12.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@playwright/test": "^1.63.0",
    "@qstyle/qwik": "^0.2.0",
    "@qstyle/vite": "^0.2.0",
    "@qwik.dev/core": "2.0.0-beta.45",
    "@qwik.dev/router": "2.0.0-beta.45",
    "@types/node": "26.6.3",
    "@unocss/reset": "^66.10.5",
    "cf": "1.0.0-beta.5",
    "eslint-plugin-qwik": "2.0.0-beta.45",
    "highlight.js": "^11.12.0",
    "miniflare": "5.20260926.0-alpha",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0"
  },
  "engines": {
    "node": "^26"
  },
  "packageManager": "pnpm@12.6.0"
}
